{
    "name": "web-shop",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "mkcert -key-file \"$HOME/.local/share/mkcert/dev-certs/key.pem\" -cert-file \"$HOME/.local/share/mkcert/dev-certs/cert.pem\" localhost 127.0.0.1 ::1 $(hostname -I) && next dev -H 0.0.0.0 -p 10000 --experimental-https --experimental-https-key \"$HOME/.local/share/mkcert/dev-certs/key.pem\" --experimental-https-cert \"$HOME/.local/share/mkcert/dev-certs/cert.pem\"",
        "build": "next build",
        "start": "next start -H 0.0.0.0 -p 10000",
        "lint": "eslint",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "db:migrate": "prisma migrate dev",
        "db:seed": "prisma db seed"
    },
    "dependencies": {
        "@auth/prisma-adapter": "^2.11.3",
        "@aws-sdk/client-s3": "^3.1120.0",
        "@aws-sdk/s3-request-presigner": "^3.1120.0",
        "@base-ui/react": "^1.7.0",
        "@prisma/adapter-pg": "^7.10.0",
        "@prisma/client": "^7.10.0",
        "@react-three/drei": "^10.7.8",
        "@react-three/fiber": "^9.7.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "dotenv": "^17.4.2",
        "lucide-react": "^1.35.0",
        "next": "16.3.3",
        "next-auth": "5.0.0-beta.32",
        "next-intl": "^4.14.1",
        "next-themes": "^0.4.6",
        "pg": "^8.23.0",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "react-dropzone": "^20.1.1",
        "shadcn": "^4.19.0",
        "sonner": "^2.0.8",
        "stripe": "^22.6.0",
        "tailwind-merge": "^3.6.0",
        "three": "^0.185.1",
        "tw-animate-css": "^1.4.0",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4",
        "@types/node": "^20",
        "@types/pg": "^8.23.1",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@types/three": "^0.185.4",
        "eslint": "^9",
        "eslint-config-next": "16.3.3",
        "eslint-config-prettier": "^10.1.8",
        "prettier": "^3.9.6",
        "prisma": "7.10.0",
        "tailwindcss": "^4",
        "tsx": "^4.23.12",
        "typescript": "^5"
    },
    "packageManager": "pnpm@11.24.0"
}
