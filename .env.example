# --- Database ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/web_shop?schema=public"

# --- Auth.js (NextAuth v5) ---
AUTH_SECRET=""
# Google OAuth (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Email (magic link) via Resend
AUTH_RESEND_KEY=""
EMAIL_FROM="onboarding@resend.dev"
# Dev/test password for the credentials login (creates a "Test login" option)
AUTH_TEST_PASSWORD=""

# --- Stripe ---
NEXT_PUBLIC_APP_URL="http://localhost:10000"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Used by docker compose `stripe-cli` service only
STRIPE_API_KEY=""

# --- Object storage (MinIO local / S3-compatible) ---
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="files"
NEXT_PUBLIC_S3_PUBLIC_URL="http://localhost:9000/files"

# --- Slicer ---
ORCA_SLICER_BIN="orca-slicer"
# Auto-process the print queue on an interval (set to 1 on a long-running server)
SLICER_AUTO_PROCESS="0"
SLICER_INTERVAL_MS="60000"
