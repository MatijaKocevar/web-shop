generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum ProductType {
  READY_MADE
  CUSTOM_PRINT
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  PRINTING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum FileFormat {
  STL
  THREE_MF
}

enum StockReason {
  ORDER
  STOCK_PRINT
  FAILURE
  RESTOCK
  CORRECTION
}

// ---- Auth (Auth.js) ----

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role      @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  orders    Order[]
  files     File[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @id
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ---- Catalog ----

model Category {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  products Product[]
}

model Tag {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  products Product[]
}

model Product {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String?
  type        ProductType @default(READY_MADE)
  price       Decimal?    @db.Decimal(12, 2)
  currency    String      @default("EUR")
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  categoryId String?
  category   Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags       Tag[]
  variants   ProductVariant[]
  images     ProductImage[]
  orderItems OrderItem[]

  modelFileId String?
  modelFile   File?     @relation("ProductModel", fields: [modelFileId], references: [id], onDelete: SetNull)
}

model ProductVariant {
  id          String  @id @default(cuid())
  name        String
  sku         String?
  stock       Int     @default(0)
  priceDelta  Decimal? @db.Decimal(12, 2)
  filamentId  String?
  grams       Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  filament  Filament? @relation(fields: [filamentId], references: [id], onDelete: SetNull)
  orderItems OrderItem[]

  @@unique([productId, name])
}

model ProductImage {
  id        String @id @default(cuid())
  key       String
  alt       String?
  sortOrder Int    @default(0)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ---- Filament & printers ----

model Filament {
  id          String  @id @default(cuid())
  name        String
  material    String
  color       String
  colorHex    String?
  density     Decimal @db.Decimal(8, 4)
  costPerGram Decimal @db.Decimal(10, 4)
  stockGrams  Int     @default(0)
  lowStockThresholdGrams Int @default(500)
  active      Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variants ProductVariant[]
  orderItems OrderItem[]
  stockLogs FilamentStockLog[]
}

model FilamentStockLog {
  id          String      @id @default(cuid())
  deltaGrams  Int
  reason      StockReason
  note        String?
  orderItemId String?
  createdAt   DateTime    @default(now())

  filamentId String
  filament   Filament @relation(fields: [filamentId], references: [id], onDelete: Cascade)

  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
}

model Printer {
  id      String  @id @default(cuid())
  name    String
  make    String
  buildX  Float
  buildY  Float
  buildZ  Float
  active  Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profiles PrinterProfile[]
}

model PrinterProfile {
  id              String  @id @default(cuid())
  name            String
  nozzle          Float
  layerHeight     Float
  infill          Int
  speed           Int?
  supports        Boolean @default(false)
  machineHourRate Decimal @db.Decimal(10, 2)
  setupFee        Decimal @db.Decimal(10, 2) @default(0)
  configJson      String? @db.Text
  active          Boolean @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  printerId String
  printer   Printer @relation(fields: [printerId], references: [id], onDelete: Cascade)

  orderItems OrderItem[]
}

// ---- Files (uploads) ----

model File {
  id        String     @id @default(cuid())
  key       String
  filename  String
  format    FileFormat
  size      Int
  hash      String
  volume    Float?
  width     Float?
  depth     Float?
  height    Float?
  createdAt DateTime   @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  orderItems    OrderItem[]
  modelProducts Product[] @relation("ProductModel")

  @@unique([hash, format])
}

// ---- Orders ----

model Order {
  id              String      @id @default(cuid())
  email           String
  status          OrderStatus @default(PENDING)
  currency        String      @default("EUR")
  subtotal        Decimal     @db.Decimal(12, 2)
  shipping        Decimal     @db.Decimal(12, 2) @default(0)
  total           Decimal     @db.Decimal(12, 2)
  stripeSessionId String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  items    OrderItem[]
  payments Payment[]
}

model OrderItem {
  id        String      @id @default(cuid())
  name      String
  type      ProductType
  quantity  Int         @default(1)
  unitPrice Decimal     @db.Decimal(12, 2)

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  fileId    String?
  file      File?    @relation(fields: [fileId], references: [id], onDelete: SetNull)
  profileId String?
  profile   PrinterProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  filamentId String?
  filament  Filament? @relation(fields: [filamentId], references: [id], onDelete: SetNull)

  stockLogs FilamentStockLog[]
}

model Payment {
  id        String   @id @default(cuid())
  stripeId  String   @unique
  amount    Decimal  @db.Decimal(12, 2)
  status    String
  createdAt DateTime @default(now())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// ---- Settings (key/value) ----

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
