# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# prisma generated client
# /generated/ (tracked so Next watches it for client changes)
/app/generated/prisma

# prisma agent-skill files (auto-generated by `prisma init`)
/.agents/
/.claude/
/.windsurf/
/skills-lock.json

# playwright browser test artifacts
/.playwright-mcp/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

certificates